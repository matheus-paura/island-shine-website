# Site
NEXT_PUBLIC_SITE_URL=https://islandshines.ca

# Quote form POST target (Formspree / Web3Forms / n8n webhook URL).
# The form no-ops with a clear error message if this is empty.
NEXT_PUBLIC_FORM_ENDPOINT=

# Analytics (all optional — leave blank to disable that tag entirely).
# Recommended: set only NEXT_PUBLIC_GTM_ID and manage GA4/Ads/Meta inside GTM.
NEXT_PUBLIC_GTM_ID=                   # e.g. GTM-XXXXXXX  (preferred container)
NEXT_PUBLIC_GA4_ID=                   # e.g. G-XXXXXXXXXX (direct GA4; skipped when GTM is set)
NEXT_PUBLIC_GOOGLE_ADS_ID=            # e.g. AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=    # conversion label for generate_lead events
NEXT_PUBLIC_META_PIXEL_ID=            # Facebook/Meta Pixel ID
NEXT_PUBLIC_CLARITY_ID=               # Microsoft Clarity project ID (heatmaps, loads only after cookie consent)
